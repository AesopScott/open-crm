{
  "name": "@clawnify/open-crm",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "wrangler d1 execute open-crm-db --local --file=src/server/schema.sql",
    "dev": "pnpm db:migrate && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clawnify/app": "^0.1.1",
    "@clawnify/connections": "^0.2.2",
    "@clawnify/db": "^0.4.1",
